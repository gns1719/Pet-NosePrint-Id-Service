xcuserdata/
DerivedData/

# 안드로이드 관련
/android/.gradle/
/android/.idea/
android/local.properties

# Flutter 심볼 관련 (디버깅, 난독화 등)
app.*.symbols
app.*.map.json

# Android Studio 빌드 결과물
/android/app/debug
/android/app/profile
/android/app/release

# 환경 변수 파일 (민감 정보 포함 시 무조건 제외)
